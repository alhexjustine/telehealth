DATABASE_URL="postgresql://telehealth:telehealth@localhost:5432/telehealth?schema=public"
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to make state-changing requests.
APP_ORIGINS=http://localhost:8080,http://localhost:5173
# Set to true when serving the app over HTTPS.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Runs the 24h/1h appointment reminder cron. Off in tests/CI/OpenAPI generation.
REMINDERS_ENABLED=true

# Optional: provisions a pre-provisioned admin account on next startup if unset
# or if no account with this email exists yet. Leave unset to skip.
ADMIN_EMAIL=admin@telehealth.local
ADMIN_PASSWORD=ChangeMe-Admin-2026
