# Every variable below has a working inline default in docker-compose.yml,
# so `docker compose up --build` runs without creating this file. Copy it to
# `.env` only to override a default for local use.

POSTGRES_USER=telehealth
POSTGRES_PASSWORD=telehealth
POSTGRES_DB=telehealth

API_PORT=3000
WEB_PORT=8080

NODE_ENV=production
LOG_LEVEL=info
