              }
            }
          }
        },
        "security": [
          {
            "th_session": []
          }
        ],
        "summary": "Adds a time-off entry",
        "tags": [
          "doctor-availability"
        ]
      }
    },
    "/doctors/me/availability/exceptions/{id}": {
      "delete": {
        "operationId": "AvailabilityController_deleteTimeOff",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "th_session": []
          }
        ],
        "summary": "Deletes one of the signed-in doctor's own time-off entries",
        "tags": [
          "doctor-availability"
        ]
      }
    },
    "/doctors/{doctorId}/slots": {
      "get": {
        "operationId": "SlotsController_getSlots",
        "parameters": [
          {
            "name": "doctorId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": true,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": true,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SlotResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "th_session": []
          }
        ],
        "summary": "Returns a doctor's available slots for a date range. Approved doctors are visible to any signed-in user; a doctor who is not yet approved can only see their own slots.",
        "tags": [
          "doctor-availability"
        ]
      }
    }
  },
  "info": {
    "title": "Telehealth API",
    "description": "REST API for the telehealth prototype",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "th_session",
        "description": "Opaque session token set by POST /auth/login or a registration endpoint."
      }
    },
    "schemas": {
      "RegisterPatientDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "10-128 characters, must not equal the email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PATIENT",
              "DOCTOR",
              "ADMIN"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "RegisterDoctorDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "10-128 characters, must not equal the email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "specializationIds": {
            "description": "At least one specialization ID from the catalog",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "licenseNumber": {
            "type": "string",
            "description": "4-32 letters, digits, or dashes"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "specializationIds",
          "licenseNumber"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "description": "10-128 characters, must not equal the email"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CurrentUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PATIENT",
              "DOCTOR",
              "ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "profileComplete": {
            "type": "boolean",
            "description": "Present only for PATIENT"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ],
            "description": "Present only for DOCTOR"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "status",
          "displayName"
        ]
      },
      "SpecializationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "description"
        ]
      },
      "PatientProfileResponseDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "nullable": true
          },
          "weightKg": {
            "type": "number",
            "nullable": true
          },
          "heightCm": {
            "type": "number",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "emergencyContactName": {
            "type": "string",
            "nullable": true
          },
          "emergencyContactPhone": {
            "type": "string",
            "nullable": true
          },
          "medicalConditions": {
            "type": "string",
            "nullable": true
          },
          "allergies": {
            "type": "string",
            "nullable": true
          },
          "currentMedications": {
            "type": "string",
            "nullable": true
          },
          "profileComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "birthDate",
          "weightKg",
          "heightCm",
          "phone",
          "emergencyContactName",
          "emergencyContactPhone",
          "medicalConditions",
          "allergies",
          "currentMedications",
          "profileComplete"
        ]
      },
      "UpdatePatientProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "example": "1990-01-31"
          },
          "weightKg": {
            "type": "number",
            "minimum": 1,
            "maximum": 500
          },
          "heightCm": {
            "type": "number",
            "minimum": 30,
            "maximum": 272
          },
          "phone": {
            "type": "string"
          },
          "emergencyContactName": {
            "type": "string"
          },
          "emergencyContactPhone": {
            "type": "string"
          },
          "medicalConditions": {
            "type": "string"
          },
          "allergies": {
            "type": "string"
          },
          "currentMedications": {
            "type": "string"
          }
        }
      },
      "SpecializationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "DoctorProfileResponseDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "yearsOfExperience": {
            "type": "number",
            "nullable": true
          },
          "licenseNumber": {
            "type": "string"
          },
          "consultationMinutes": {
            "type": "number"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "reviewNote": {
            "type": "string",
            "nullable": true
          },
          "specializations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpecializationSummaryDto"
            }
          }
        },
        "required": [
          "firstName",
          "lastName",
          "bio",
          "yearsOfExperience",
          "licenseNumber",
          "consultationMinutes",
          "verificationStatus",
          "reviewNote",
          "specializations"
        ]
      },
      "UpdateDoctorProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "yearsOfExperience": {
            "type": "number",
            "minimum": 0,
            "maximum": 70
          },
          "licenseNumber": {
            "type": "string",
            "description": "4-32 letters, digits, or dashes"
          },
          "consultationMinutes": {
            "type": "number",
            "enum": [
              15,
              20,
              30,
              45,
              60
            ]
          },
          "specializationIds": {
            "description": "Replaces the full set of specializations; at least one is required when provided",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AvailabilityRuleResponseDto": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number",
            "minimum": 1,
            "maximum": 7
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1440
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1440
          }
        },
        "required": [
          "weekday",
          "startMinute",
          "endMinute"
        ]
      },
      "TimeOffResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "startsAt",
          "endsAt",
          "reason"
        ]
      },
      "AvailabilityResponseDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA time zone"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityRuleResponseDto"
            }
          },
          "timeOff": {
            "description": "Time off that ends in the future",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeOffResponseDto"
            }
          }
        },
        "required": [
          "timezone",
          "rules",
          "timeOff"
        ]
      },
      "AvailabilityRuleDto": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "number",
            "minimum": 1,
            "maximum": 7,
            "description": "ISO weekday: Monday = 1, Sunday = 7"
          },
          "startMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1440,
            "description": "Minutes since local midnight"
          },
          "endMinute": {
            "type": "number",
            "minimum": 0,
            "maximum": 1440,
            "description": "Minutes since local midnight"
          }
        },
        "required": [
          "weekday",
          "startMinute",
          "endMinute"
        ]
      },
      "SaveAvailabilityDto": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA time zone, e.g. Asia/Manila"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityRuleDto"
            }
          }
        },
        "required": [
          "timezone",
          "rules"
        ]
      },
      "CreateTimeOffDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
