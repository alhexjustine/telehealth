generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN

  @@map("role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  passwordHash  String        @map("password_hash")
  role          Role
  status        AccountStatus @default(ACTIVE)
  statusReason  String?       @map("status_reason")
  lastLoginAt   DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             Session[]
  patientProfile       PatientProfile?
  doctorProfile        DoctorProfile?
  cancelledAppointments Appointment[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent   String?   @map("user_agent")
  ip          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_status")
}

model PatientProfile {
  userId                 String    @id @map("user_id") @db.Uuid
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  birthDate              DateTime? @map("birth_date") @db.Date
  weightKg               Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 2)
  phone                  String?
  emergencyContactName   String?   @map("emergency_contact_name")
  emergencyContactPhone  String?   @map("emergency_contact_phone")
  medicalConditions      String?   @map("medical_conditions")
  allergies              String?
  currentMedications     String?   @map("current_medications")
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patient_profiles")
}

model DoctorProfile {
  userId               String              @id @map("user_id") @db.Uuid
  firstName            String              @map("first_name")
  lastName             String              @map("last_name")
  bio                  String?
  yearsOfExperience    Int?                @map("years_of_experience")
  licenseNumber        String              @unique @map("license_number")
  consultationMinutes  Int                 @default(30) @map("consultation_minutes")
  verificationStatus   VerificationStatus  @default(PENDING) @map("verification_status")
  reviewNote           String?             @map("review_note")
  timezone             String              @default("UTC")
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations         DoctorSpecialization[]
  availabilityRules       AvailabilityRule[]
  availabilityExceptions  AvailabilityException[]
  appointments            Appointment[]

  @@map("doctor_profiles")
}

/// A doctor's weekly working range: a weekday (1-7, ISO, Monday = 1) plus a
/// start and end time of day in minutes since local midnight (0-1440, steps of
/// 15), interpreted in `DoctorProfile.timezone`. Slots are computed from these
/// on every read; nothing about slots is stored.
model AvailabilityRule {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@index([doctorId])
  @@map("availability_rules")
}

/// A block of time, stored as UTC instants, during which a doctor offers no
/// slots regardless of their weekly schedule.
model AvailabilityException {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@index([doctorId])
  @@map("availability_exceptions")
}

model Specialization {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String  @unique
  description String

  doctors  DoctorSpecialization[]
  symptoms SymptomSpecialization[]

  @@map("specializations")
}

/// Reference data for guided symptom matching (`add-doctor-discovery`), shipped
/// by a data migration like the specialization catalog. Read-only: nothing in
/// the app writes to this table.
model Symptom {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  name      String
  category  String
  keywords  String[]
  isRedFlag Boolean @default(false) @map("is_red_flag")

  specializations SymptomSpecialization[]
  appointments    AppointmentSymptom[]

  @@map("symptoms")
}

model SymptomSpecialization {
  symptomId        String @map("symptom_id") @db.Uuid
  specializationId String @map("specialization_id") @db.Uuid
  /// 1-3; how strongly this symptom points to the specialization.
  weight           Int

  symptom        Symptom        @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([symptomId, specializationId])
  @@map("symptom_specializations")
}

model DoctorSpecialization {
  doctorId         String @map("doctor_id") @db.Uuid
  specializationId String @map("specialization_id") @db.Uuid

  doctor         DoctorProfile  @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  /// Set by a later change (`add-consultations-and-records`); nothing in this
  /// change sets it. Included now so that change needs no enum migration.
  COMPLETED

  @@map("appointment_status")
}

/// A booked, cancelled, or completed consultation between a patient and a
/// doctor. Overlap for the same doctor or the same patient among `BOOKED`
/// rows is prevented at the database level by two `EXCLUDE USING gist`
/// constraints added by hand in this model's migration (Prisma's schema
/// language can't express them) — see design.md's "Exclusion constraints in
/// raw SQL". A following `prisma migrate dev` must not generate a migration
/// that drops them; `test/appointment-constraints.e2e-spec.ts` pins this.
model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  reason             String            @db.VarChar(500)
  status             AppointmentStatus @default(BOOKED)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?           @map("cancelled_by_id") @db.Uuid
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  rescheduledFromId  String?           @unique @map("rescheduled_from_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient         PatientProfile       @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  doctor          DoctorProfile        @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  cancelledBy     User?                @relation(fields: [cancelledById], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment?         @relation("AppointmentReschedule")
  symptoms        AppointmentSymptom[]

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}

/// The symptom IDs a patient carried over from guided matching when booking,
/// kept on the appointment for the doctor to see. Read-only join of
/// `Appointment` and the fixed `Symptom` catalog.
model AppointmentSymptom {
  appointmentId String @map("appointment_id") @db.Uuid
  symptomId     String @map("symptom_id") @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  symptom     Symptom     @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([appointmentId, symptomId])
  @@map("appointment_symptoms")
}
