# Rendered by nginx:alpine's built-in docker-entrypoint (files under /etc/nginx/templates/ are
# passed through envsubst, restricted to names present in the container's env — see
# apps/web/Dockerfile). DNS_RESOLVER/API_UPSTREAM_HOST/API_UPSTREAM_PORT default (in
# docker-compose.yml) to Docker's embedded DNS and the `api` Compose service name; a Fly.io
# deploy (fly.web.toml) instead points this at the API app's Fly 6PN internal hostname and
# resolver, so the SPA and API stay same-origin in both environments. See docs/deploy/fly.md.
resolver ${DNS_RESOLVER} valid=10s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        # Applies only to SPA responses served from this location — nginx
        # does not merge `add_header` from a location that defines its own
        # into a sibling location, so `/api/` and `/socket.io/` below are
        # unaffected and keep relying on the API's own helmet-set CSP.
        # script-src/frame-src additions let the consultation workspace embed Jitsi's public
        # meet.jit.si video call (see the add-consultation-video change's design.md — a
        # documented, prototype-only exception to this project's standalone-runtime rule).
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://meet.jit.si https://8x8.vc; style-src 'self' 'unsafe-inline'; script-src 'self' https://meet.jit.si https://8x8.vc; frame-src https://meet.jit.si; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }

    location /api/ {
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $http_x_request_id;
    }

    location /socket.io/ {
        set $api_upstream http://${API_UPSTREAM_HOST}:${API_UPSTREAM_PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
