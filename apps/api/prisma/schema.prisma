generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN

  @@map("role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  status       AccountStatus @default(ACTIVE)
  statusReason String?       @map("status_reason")
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              Session[]
  patientProfile        PatientProfile?
  doctorProfile         DoctorProfile?
  cancelledAppointments Appointment[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  sentMessages          Message[]
  hiddenReviews         DoctorReview[]
  requestedRefills      PrescriptionRefillRequest[] @relation("RefillRequestedBy")
  decidedRefills        PrescriptionRefillRequest[] @relation("RefillDecidedBy")

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_status")
}

model PatientProfile {
  userId                String    @id @map("user_id") @db.Uuid
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  birthDate             DateTime? @map("birth_date") @db.Date
  weightKg              Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  heightCm              Decimal?  @map("height_cm") @db.Decimal(5, 2)
  phone                 String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  medicalConditions     String?   @map("medical_conditions")
  allergies             String?
  currentMedications    String?   @map("current_medications")
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  dependents   Dependent[]
  reviews      DoctorReview[]
  favorites    DoctorFavorite[]

  @@map("patient_profiles")
}

enum DependentRelationship {
  CHILD
  PARENT
  SPOUSE
  OTHER

  @@map("dependent_relationship")
}

/// A person a patient account books on behalf of (child, parent, spouse, or other) — no login of
/// their own; the account holder does everything for them (`add-dependent-booking`). Mirrors
/// `PatientProfile`'s medical-history shape, but `birthDate` is required here (age is central to
/// how a doctor reads the workspace/record). Soft-removed via `removedAt`, never hard-deleted, so
/// an `Appointment.dependentId` can never be orphaned.
model Dependent {
  id                 String                @id @default(uuid()) @db.Uuid
  patientId          String                @map("patient_id") @db.Uuid
  firstName          String                @map("first_name")
  lastName           String                @map("last_name")
  birthDate          DateTime              @map("birth_date") @db.Date
  relationship       DependentRelationship
  medicalConditions  String?               @map("medical_conditions")
  allergies          String?
  currentMedications String?               @map("current_medications")
  removedAt          DateTime?             @map("removed_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient      PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  appointments Appointment[]

  @@index([patientId])
  @@map("dependents")
}

model DoctorProfile {
  userId              String             @id @map("user_id") @db.Uuid
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  bio                 String?
  yearsOfExperience   Int?               @map("years_of_experience")
  licenseNumber       String             @unique @map("license_number")
  consultationMinutes Int                @default(30) @map("consultation_minutes")
  acceptingBookings   Boolean            @default(true) @map("accepting_bookings")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  reviewNote          String?            @map("review_note")
  timezone            String             @default("UTC")
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations        DoctorSpecialization[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  reviews                DoctorReview[]
  favoritedBy            DoctorFavorite[]

  @@map("doctor_profiles")
}

/// A doctor's weekly working range: a weekday (1-7, ISO, Monday = 1) plus a
/// start and end time of day in minutes since local midnight (0-1440, steps of
/// 15), interpreted in `DoctorProfile.timezone`. Slots are computed from these
/// on every read; nothing about slots is stored.
model AvailabilityRule {
  id          String   @id @default(uuid()) @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@index([doctorId])
  @@map("availability_rules")
}

/// A block of time, stored as UTC instants, during which a doctor offers no
/// slots regardless of their weekly schedule.
model AvailabilityException {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@index([doctorId])
  @@map("availability_exceptions")
}

model Specialization {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  name        String @unique
  description String

  doctors  DoctorSpecialization[]
  symptoms SymptomSpecialization[]

  @@map("specializations")
}

/// Reference data for guided symptom matching (`add-doctor-discovery`), shipped
/// by a data migration like the specialization catalog. Read-only: nothing in
/// the app writes to this table.
model Symptom {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  category  String
  keywords  String[]
  isRedFlag Boolean  @default(false) @map("is_red_flag")

  specializations SymptomSpecialization[]
  appointments    AppointmentSymptom[]

  @@map("symptoms")
}

model SymptomSpecialization {
  symptomId        String @map("symptom_id") @db.Uuid
  specializationId String @map("specialization_id") @db.Uuid
  /// 1-3; how strongly this symptom points to the specialization.
  weight           Int

  symptom        Symptom        @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([symptomId, specializationId])
  @@map("symptom_specializations")
}

model DoctorSpecialization {
  doctorId         String @map("doctor_id") @db.Uuid
  specializationId String @map("specialization_id") @db.Uuid

  doctor         DoctorProfile  @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
  @@map("doctor_specializations")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  /// Set by `ConsultationsService.complete` when the doctor completes the
  /// consultation session (`add-consultations-and-records`).
  COMPLETED
  /// Set by `AdminAppointmentsService.markNotHeld`: a past `BOOKED`
  /// appointment that was never completed, resolved by an administrator
  /// instead of staying flagged forever (`add-admin-console`).
  NOT_HELD

  @@map("appointment_status")
}

/// A booked, cancelled, or completed consultation between a patient and a
/// doctor. Overlap for the same doctor or the same patient among `BOOKED`
/// rows is prevented at the database level by two `EXCLUDE USING gist`
/// constraints added by hand in this model's migration (Prisma's schema
/// language can't express them) — see design.md's "Exclusion constraints in
/// raw SQL". A following `prisma migrate dev` must not generate a migration
/// that drops them; `test/appointment-constraints.e2e-spec.ts` pins this.
model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  doctorId           String            @map("doctor_id") @db.Uuid
  /// Who this appointment is for, if not the account holder themselves (`null` means the account
  /// holder) — see `add-dependent-booking`'s design.md's "RBAC stays keyed on the account".
  dependentId        String?           @map("dependent_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  reason             String            @db.VarChar(500)
  status             AppointmentStatus @default(BOOKED)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?           @map("cancelled_by_id") @db.Uuid
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  /// The administrator's reason for `NOT_HELD`, e.g. "Patient did not
  /// attend" (`add-admin-console`). Kept separate from `cancellationReason`
  /// since the appointment was never cancelled.
  resolutionReason   String?           @map("resolution_reason") @db.VarChar(500)
  rescheduledFromId  String?           @unique @map("rescheduled_from_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient             PatientProfile       @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  doctor              DoctorProfile        @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  dependent           Dependent?           @relation(fields: [dependentId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation(fields: [cancelledById], references: [id], onDelete: SetNull)
  rescheduledFrom     Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo       Appointment?         @relation("AppointmentReschedule")
  symptoms            AppointmentSymptom[]
  notifications       Notification[]
  consultationSession ConsultationSession?
  consultationNote    ConsultationNote?
  prescriptions       Prescription[]
  messages            Message[]
  review              DoctorReview?

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([patientId, dependentId])
  @@map("appointments")
}

/// The symptom IDs a patient carried over from guided matching when booking,
/// kept on the appointment for the doctor to see. Read-only join of
/// `Appointment` and the fixed `Symptom` catalog.
model AppointmentSymptom {
  appointmentId String @map("appointment_id") @db.Uuid
  symptomId     String @map("symptom_id") @db.Uuid

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  symptom     Symptom     @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([appointmentId, symptomId])
  @@map("appointment_symptoms")
}

enum NotificationType {
  APPOINTMENT_BOOKED
  BOOKING_CONFIRMED
  APPOINTMENT_RESCHEDULED
  RESCHEDULE_CONFIRMED
  APPOINTMENT_CANCELLED
  REMINDER_24H
  REMINDER_1H
  /// Sent to the patient when the doctor completes a consultation
  /// (`add-consultations-and-records`); links to the record detail page.
  CONSULTATION_SUMMARY_AVAILABLE
  /// Sent to a doctor when an administrator approves their profile
  /// (`add-admin-console`).
  PROFILE_APPROVED
  /// Sent to a doctor when an administrator rejects their profile, with the
  /// review note (`add-admin-console`).
  PROFILE_REJECTED
  /// Sent to every still-active participant when an appointment is
  /// cancelled by an administrator, or as a side effect of the other
  /// participant's account being deactivated (`add-admin-console`); the
  /// counterpart of the cancelling admin action, not the acting admin.
  PLATFORM_APPOINTMENT_CANCELLED
  /// Sent to the other participant when a message is sent on their shared
  /// appointment (`add-consultation-messaging`); never includes the message
  /// body.
  NEW_MESSAGE
  /// Sent to the treating doctor when a patient requests a prescription
  /// refill (`add-prescription-refills`); links to the doctor's refill queue.
  REFILL_REQUESTED
  /// Sent to the requesting account when a doctor approves or denies a
  /// refill request (`add-prescription-refills`); links back to the record.
  REFILL_DECIDED

  @@map("notification_type")
}

/// One row per recipient per event, written inside the same transaction as
/// the event that caused it (see `withNotifications` in the notifications
/// module) so a notification never outlives — or is missing for — the event
/// it describes. `title`/`body` are plain text with no formatted times
/// (the server doesn't know the viewer's time zone); `data` carries the raw
/// values (`startsAt`, `previousStartsAt`, `counterpartName`, `reason`) so
/// the web can format them itself. Later changes add `NotificationType`
/// values in their own migrations.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String           @db.VarChar(120)
  body          String           @db.VarChar(500)
  data          Json?
  link          String?          @db.VarChar(200)
  appointmentId String?          @map("appointment_id") @db.Uuid
  /// Used by the reminder job to make re-running the cron idempotent, e.g.
  /// `reminder:24h:{appointmentId}:{userId}`. Appointment-event notifications
  /// don't set one; Postgres allows any number of `NULL`s in a unique index.
  dedupeKey     String?          @unique @map("dedupe_key")
  readAt        DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

enum SessionState {
  SCHEDULED
  JOINED
  IN_PROGRESS
  COMPLETED

  @@map("session_state")
}

/// The consultation workspace for one appointment, lazily created on the
/// first join (a missing row means `SCHEDULED` — see
/// `ConsultationsService`/`consultation-state.ts`). One row per appointment;
/// `appointmentId` is both the primary key and the foreign key.
model ConsultationSession {
  appointmentId   String       @id @map("appointment_id") @db.Uuid
  state           SessionState @default(SCHEDULED)
  patientJoinedAt DateTime?    @map("patient_joined_at") @db.Timestamptz(3)
  doctorJoinedAt  DateTime?    @map("doctor_joined_at") @db.Timestamptz(3)
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("consultation_sessions")
}

/// The doctor's findings/assessment/plan/patient-summary for one appointment.
/// One row per appointment, upserted by `RecordsService.saveNote`; locked
/// once the session is `COMPLETED` (see `ClinicalAccessPolicy.canWriteRecord`).
model ConsultationNote {
  appointmentId  String   @id @map("appointment_id") @db.Uuid
  findings       String?  @db.VarChar(4000)
  assessment     String?  @db.VarChar(4000)
  plan           String?  @db.VarChar(4000)
  patientSummary String?  @map("patient_summary") @db.VarChar(4000)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("consultation_notes")
}

/// One medication prescribed during a consultation. A consultation may have
/// several; capped at 20 by `RecordsService` (application-level, not a
/// database constraint).
model Prescription {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  medication    String   @db.VarChar(120)
  dosage        String   @db.VarChar(60)
  frequency     String   @db.VarChar(60)
  duration      String   @db.VarChar(60)
  instructions  String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment    Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  refillRequests PrescriptionRefillRequest[]

  @@index([appointmentId])
  @@map("prescriptions")
}

enum RefillRequestStatus {
  PENDING
  APPROVED
  DENIED

  @@map("refill_request_status")
}

/// A patient's request to renew a past, completed consultation's
/// prescription, decided by the treating doctor (`add-prescription-refills`).
/// Never mutates the locked `Prescription`/`ConsultationNote` it points
/// to — this row itself, once decided, *is* the "this was renewed" record
/// (see design.md's "Approving does not reopen the record").
model PrescriptionRefillRequest {
  id             String              @id @default(uuid()) @db.Uuid
  prescriptionId String              @map("prescription_id") @db.Uuid
  requestedById  String              @map("requested_by_id") @db.Uuid
  patientNote    String?             @db.VarChar(500)
  status         RefillRequestStatus @default(PENDING)
  doctorNote     String?             @db.VarChar(500)
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("RefillRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("RefillDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([status])
  @@map("prescription_refill_requests")
}

/// One text message exchanged between the patient and doctor of an
/// appointment, threaded by `appointmentId` (`add-consultation-messaging`).
/// Append-only: there is no update or delete endpoint. `senderId` identifies
/// which of the appointment's two participants sent it.
model Message {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  senderId      String   @map("sender_id") @db.Uuid
  body          String   @db.VarChar(2000)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("messages")
}

/// One patient account's rating/comment on a doctor for one completed
/// appointment (`add-doctor-reviews`). `appointmentId` is `@unique`, so
/// "once per appointment, editable" falls out of an upsert rather than a
/// separate uniqueness check (see design.md's "One row per appointment,
/// upserted"). `doctorId`/`patientId` are denormalized from the appointment
/// purely for indexing (aggregate-by-doctor, list-by-patient) — the
/// appointment relation remains the source of truth. Soft-hidden via
/// `hiddenAt`/`hiddenById`/`hiddenReason`, mirroring `Dependent.removedAt`,
/// never hard-deleted, so a moderation decision stays reversible and
/// auditable. The `rating BETWEEN 1 AND 5` bound is a hand-written CHECK
/// constraint (Prisma's schema language can't express it) added by this
/// model's migration.
model DoctorReview {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @unique @map("appointment_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  rating        Int
  comment       String?   @db.VarChar(1000)
  hiddenAt      DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenById    String?   @map("hidden_by_id") @db.Uuid
  hiddenReason  String?   @map("hidden_reason") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  hiddenBy    User?          @relation(fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([doctorId, hiddenAt])
  @@map("doctor_reviews")
}

/// A patient account's bookmark of a doctor (`add-doctor-favorites`) — purely
/// organizational, no effect on search ranking or specialty matching. Unique
/// per (patientId, doctorId) so favoriting is idempotent at the DB level too.
model DoctorFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient PatientProfile @relation(fields: [patientId], references: [userId], onDelete: Cascade)
  doctor  DoctorProfile  @relation(fields: [doctorId], references: [userId], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("doctor_favorites")
}

enum AuditAction {
  USER_STATUS_CHANGED
  DOCTOR_APPROVED
  DOCTOR_REJECTED
  DOCTOR_PROFILE_UPDATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_MARKED_NOT_HELD
  ADMIN_SIGNED_IN
  REVIEW_HIDDEN
  REVIEW_UNHIDDEN

  @@map("audit_action")
}

/// One entry per administrator action (and admin sign-in), written by
/// `AuditService.record` inside the same transaction as the action it
/// describes. Append-only: this model's migration adds a trigger that
/// rejects any UPDATE or DELETE on this table (see design.md's "Audit log
/// model and immutability"); only `TRUNCATE`, used solely by the e2e
/// reset-database test helper, bypasses it. `before`/`after` hold only the
/// changed, allow-listed fields (`diffFields`) — never passwords, session
/// tokens, or clinical content. `entityId` has no foreign key: its target
/// table varies with `entityType`.
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(40)
  entityId   String?     @map("entity_id") @db.Uuid
  reason     String?
  before     Json?
  after      Json?
  requestId  String      @map("request_id")
  ip         String?
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
