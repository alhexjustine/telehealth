{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node -c yellow,cyan \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/src/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "pretest:e2e": "pnpm run build && DATABASE_URL=${DATABASE_URL:-postgresql://telehealth:telehealth@localhost:5432/telehealth_test?schema=public} prisma migrate deploy",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "preopenapi:generate": "pnpm run build",
    "openapi:generate": "node dist/scripts/generate-openapi.js",
    "pregenerate:data-model-diagram": "pnpm run build",
    "generate:data-model-diagram": "node dist/scripts/generate-data-model-diagram.js",
    "postinstall": "test -f src/generated/prisma/client.ts || prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "preadmin:provision": "pnpm run build",
    "admin:provision": "node dist/scripts/provision-admin.js",
    "predemo:seed": "pnpm run build",
    "demo:seed": "node dist/scripts/seed-demo.js",
    "predemo:live": "pnpm run build",
    "demo:live": "node dist/scripts/seed-demo.js --live-consultation",
    "predemo:reset": "pnpm run build",
    "demo:reset": "node dist/scripts/seed-demo.js --reset"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-socket.io": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/websockets": "12.1.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "18.0.3",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.1",
    "pg": "8.16.3",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "concurrently": "10.0.5",
    "jest": "30.2.0",
    "pino-pretty": "13.1.2",
    "socket.io-client": "4.8.4",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
