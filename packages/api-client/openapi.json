    "/doctors/me/availability": {
      "get": {
        "operationId": "AvailabilityController_getAvailability",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "th_session": []
          }
        ],
        "summary": "Returns the signed-in doctor's time zone, weekly schedule, and upcoming time off",
        "tags": [
          "doctor-availability"
        ]
      },
      "put": {
        "operationId": "AvailabilityController_saveAvailability",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveAvailabilityDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
