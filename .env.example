# Every variable below has a working inline default in docker-compose.yml,
# so `docker compose up --build` runs without creating this file. Copy it to
# `.env` only to override a default for local use.

POSTGRES_USER=telehealth
POSTGRES_PASSWORD=telehealth
POSTGRES_DB=telehealth

API_PORT=3000
WEB_PORT=8080

NODE_ENV=production
LOG_LEVEL=info

# Comma-separated list of origins allowed to make state-changing requests.
APP_ORIGINS=http://localhost:8080
# Set to true when serving the app over HTTPS.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# Runs the 24h/1h appointment reminder cron. Off in tests/CI/OpenAPI generation.
REMINDERS_ENABLED=true

# Pre-provisioned admin account, created once on first startup and never
# overwritten afterward. These are local-only defaults; change them for any
# non-local deployment. See README.md.
ADMIN_EMAIL=admin@telehealth.local
ADMIN_PASSWORD=ChangeMe-Admin-2026

# Loads a fictional demo dataset (accounts, doctors, appointments, records) after migrations and
# admin provisioning, so the app can be explored immediately. Idempotent — safe to leave on
# across restarts. Set to false to start from an empty database. See docs/guide/demo.md.
DEMO_DATA=true

# Testing only: skips the consultation join-window check ([-15m, +30m] around the appointment),
# so any booked appointment can be entered immediately instead of waiting for the window. Never
# set true for anything beyond local manual testing.
JOIN_WINDOW_DISABLED=false

# Derives each appointment's Jitsi video-call room name (an HMAC of the appointment ID), so the
# room can't be found by guessing/enumerating appointment IDs. This is a local-only default;
# change it for any non-local deployment. See README.md. The video call itself uses Jitsi's
# public meet.jit.si server — a documented, prototype-only exception to this project's
# standalone-runtime rule (see docs/guide/demo.md).
JITSI_ROOM_SECRET=dev-only-change-me
